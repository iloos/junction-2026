		{
			"q": "porkkana",
			"accept": "porkkana",
			"reject": "laatikko|kakku|mehu|sose|raaste.*kaali|keitto"
		},
		{ "q": "vehnäjauho", "accept": "vehnäjauho", "reject": "gluteeniton|leipä" },
		{
			"q": "puuroriisi",
			"accept": "puuroriisi|pyöreäjyväinen riisi",
			"reject": "valmis|piirakka|puuro .*valmis"
		},
		{
