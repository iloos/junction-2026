{
	"$comment": "Ingredient queries as a menu or request would send them (Finnish, as the request lexicon does). `accept` is a regex over the product's Finnish name for the product type the query means; `reject` excludes look-alikes (ready dishes, flavoured or processed items). `expectEmpty` queries name nothing in the catalogue and must stay unresolved. Written by session 1f, 14 Nov 2026; regex-judged, so a precision figure is approximate.",
	"k": 5,
	"queries": [
		{ "q": "voi", "accept": "(^| )voi( |$)", "reject": "voileip|kaali|voitaikina|voitorttu" },
		{
			"q": "maito",
			"accept": "maito",
			"reject": "suklaa|kaakao|jauhe|kahvi|kaura|soija|manteli|kookos|juoma"
		},
		{
			"q": "kuohukerma",
			"accept": "kuohukerma|vispikerma",
			"reject": "jäätelö|kakku|kastike|juusto"
		},
		{ "q": "ruokakerma", "accept": "ruokakerma", "reject": "juusto|sipuli|savujuusto|kastike" },
		{ "q": "kananmuna", "accept": "kananmuna", "reject": "pasta|majonees|nuudeli|tagliatelle" },
		{
			"q": "peruna",
			"accept": "peruna",
			"reject": "lastu|sose|kiusaus|laatikko|salaatti|muusi|ranskalai|lohko|jauhe|rösti"
		},
		{ "q": "lanttu", "accept": "lanttu", "reject": "laatikko" },
		{
			"q": "naudan jauheliha",
