		},
		{
			"q": "kurkku",
			"accept": "kurkku",
			"reject": "suolakurkku|maustekurkku|etikka|säilyke|tzatziki"
		},
		{
			"q": "sokeri",
			"accept": "sokeri",
			"reject": "sokeroitu|sokeriton|kakku|kuorrute|leivos|makeinen"
		},
		{
			"q": "kinkku",
			"accept": "kinkku",
			"reject": "piirakka|pizza|kiusaus|kastike|makkara|sämpylä|patonki|leipä|toast"
