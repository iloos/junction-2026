// Sticky router in front of the Aiven app machines. Test on workers.dev only; binding app.mandate.kitchen is the
// lead's call. Deploy from this folder: `npx wrangler@4 deploy`.
{
	"name": "mandate-router",
	"main": "worker.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"vars": {
		// prod (mandate) and staging for the first test; mandate-b replaces staging once it has its env.
		"UPSTREAMS": "https://widely-many-scorpion.eur-1.aiven.app,https://ideally-expert-wolf.eur-1.aiven.app"
	}
}
