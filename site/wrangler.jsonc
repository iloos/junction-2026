// Static site for mandate.kitchen. Deploy from this folder: `npx wrangler@4 deploy`.
{
	"name": "mandate-landing",
	"main": "worker.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"routes": [
		{ "pattern": "mandate.kitchen", "custom_domain": true },
		{ "pattern": "www.mandate.kitchen", "custom_domain": true }
	]
}
