{
	"name": "junction-2026",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"eval": "vitest run --project server src/lib/server/evals",
		"db:migrate": "node --env-file=.env scripts/db-migrate.ts",
		"db:seed": "node --env-file=.env scripts/seed-db.ts",
		"test:live": "node --env-file=.env node_modules/vitest/vitest.mjs run --project server src/lib/server/adapters/decide/live.test.ts",
		"eval:agent": "vitest run --project server src/lib/server/agent -t \"suite: agent goal trials|suite: adversarial authority\"",
		"test:pg": "node scripts/test-pg.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.20.0",
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.92",
		"@electric-sql/pglite": "^0.5.16",
		"@electric-sql/pglite-pgvector": "^0.0.17",
		"@google/genai": "^3.3.0",
		"@lucide/svelte": "^1.72.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"ai": "^7.0.173",
		"bits-ui": "^2.21.0",
		"d3": "^7.9.2",
		"d3-transition": "^3.0.2",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.1",
		"zod": "^4.6.7",
		"zod-openapi": "^6.0.2"
	}
}
