# Names only. Real values go in .env (gitignored). Read only from src/lib/server/.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Nemotron via NVIDIA Build (https://integrate.api.nvidia.com/v1); one key per teammate, ~40 req/min each
NVIDIA_API_KEY=
FEATHERLESS_API_KEY=
# Verda: inference key for the OpenAI-compatible API (used by the app); cloud client id/secret for the CLI/API;
# object-storage keys (S3-compatible). The CLI keeps its own login in ~/.verda/credentials.
VERDA_INFERENCE_KEY=
VERDA_CLOUD_ID=
VERDA_CLOUD_KEY=
VERDA_OBJ_ACCESS_KEY=
VERDA_OBJ_SECRET_KEY=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
# Valio Aimo mock backend (key from the challenge brief / resource portal)
VALIO_API_KEY=
CALA_API_KEY=
SONIOX_API_KEY=
# Modal: the CLI keeps its token in ~/.modal.toml (`modal token set ... --profile=<name>`).
# These are only needed where no profile exists (CI, a teammate's shell). Modal's own names:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Postgres: Aiven service URI in deploy/shared dev; local dev can use postgres://postgres:dev@localhost:5432/postgres
DATABASE_URL=
# Aiven personal token, for the avn CLI / local MCP only (never needed by the app)
AIVEN_TOKEN=
# Cloudinary (cloud name is not secret). App uses the "code" key pair; the "agent" pair is for an MCP/agent client.
# Node SDK also accepts CLOUDINARY_URL=cloudinary://<CODE_KEY>:<CODE_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_CODE_KEY=
CLOUDINARY_API_CODE_SECRET=
CLOUDINARY_API_AGENT_KEY=
CLOUDINARY_API_AGENT_SECRET=
CLOUDINARY_URL=
# LLM provider for the agent port: anthropic | gemini | nemotron | featherless | verda | fixture
LLM_PROVIDER=fixture
