# Names only. Real values go in .env (gitignored); the app reads them in src/lib/server/ only.
# Every name below is read by src/ or scripts/. Empty = off or the documented default.

# --- Database ---
# Aiven Postgres service URI; empty = PGlite in memory + the file catalogue (offline demo, tests)
DATABASE_URL=
# Path to the Aiven CA cert (certs/*.pem is gitignored); used by the app and scripts/db-migrate.ts
PG_CA_CERT=
# The same CA as base64, for containers without a cert file (Aiven Runtime); wins over PG_CA_CERT
PROJECT_CA_CERT=
# 1 = print a tally of SQL statements every 10 s (diagnostics)
SQL_TRACE=
# 1 = let vitest use DATABASE_URL (pnpm test:pg sets it); otherwise tests always use PGlite
MANDATE_TEST_PG=

# --- Auth and keys (src/lib/server/auth, src/lib/server/demo) ---
# Bearer keys per actor, ≥ 16 chars; the chef and approver keys also sign presenters in on /ops
MANDATE_KEY_CHEF=
MANDATE_KEY_KITCHEN_AGENT=
MANDATE_KEY_EXTERNAL_AGENT=
MANDATE_KEY_APPROVER=
# Extra keys: label:actor:key[:workspace],… (default workspace ws-judges)
MCP_KEYS=
# 1 = accept the public fixture keys (fx-chef, …) outside dev
MANDATE_FIXTURE_KEYS=
# Workspace and run for env keys without one (default ws-demo / run-1)
MANDATE_WORKSPACE=
MANDATE_RUN=
# HMAC secret for visitor cookies and judge keys (D9); empty = judge keys off
JUDGE_KEY_SECRET=
# ISO time judge keys expire (default the end of the event)
JUDGE_KEY_EXPIRES=

# --- LLM (src/lib/server/adapters/{llm,decide}) ---
# fixture (default) | gemini | featherless; a missing key falls back to fixture
LLM_PROVIDER=fixture
# Gemini key (AI Studio); GEMINI_API_KEY is read when the studio name is empty
GEMINI_STUDIO_API_KEY=
GEMINI_API_KEY=
# Featherless (OpenAI-compatible) for Gemma; model defaults to google/gemma-4-E4B-it
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
# llm = the agent plans with the model; anything else = the scripted planner
AGENT_PLANNER=
# 1 = record live Gemini Decisions answers into the replay file
DECIDE_RECORD=
# 1 = run the opt-in live tests (pnpm test:live, request parse live test)
DECIDE_LIVE=
# Daily Gemini Decisions calls per visitor workspace (default 300) and per instance (default 5000); over a cap → replay/rules, labelled
DECIDE_CAP_PER_WORKSPACE=
DECIDE_CAP_GLOBAL=
# Daily Gemini text calls (all router jobs) per visitor workspace (default 200) and per instance (default 3000); over a cap → the rules fallback
LLM_CAP_PER_WORKSPACE=
LLM_CAP_GLOBAL=
# pnpm eval:live options: repeats per goal (default 3), goal id prefix, 1 = fail on task pass rate
LIVE_REPEATS=
LIVE_ONLY=
LIVE_STRICT=

# --- Web (src/lib/server/web) ---
# live | fixture (default fixture, live in production when both keys are set)
WEB_PROVIDER=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
# Context.dev monitor webhook signing secret
CONTEXT_DEV_WEBHOOK_SECRET=
# Response cache, findings, recall queue and spend ledger (default scratch/web-cache)
WEB_CACHE_DIR=
# Daily call caps per API: per key (default 40) and global (default 1000)
WEB_CAP_PER_KEY=
WEB_CAP_GLOBAL=
# Workspaces where monitor recalls are applied (default ws-demo)
WEB_RECALL_WORKSPACES=

# --- Catalogue ---
# Valio mock API key, for scripts/probe only (export it; the app reads the cache, never the key)
VALIO_API_KEY=
# Valio mock API base URL for the probe (default https://junction26.valioaimo.fi)
VALIO_BASE_URL=
# Substitute candidates: hybrid (default) | id
CATALOG_RETRIEVAL=
# Free-text search: id (default, substring) | hybrid
CATALOG_SEARCH=

# --- Demo ---
# 1 = everyone is a presenter (stage access, stage reset); never on the public deploy
DEMO_RESET_OPEN=

# --- Deploy, smoke and gate scripts (scripts/deploy, scripts/smoke-race.mjs, e2e) ---
# kitchen_agent key bound to its own workspace in MCP_KEYS (e.g. smoke:kitchen_agent:<key>:ws-smoke): smoke resets it and runs the race check
SMOKE_KEY=
# ok = smoke fails unless /healthz reports the database
EXPECT_DB=
# Race smoke kitchen and delivery date (default k-hotel, 2026-12-10)
SMOKE_KITCHEN=
SMOKE_DELIVER_BY=
# Base URLs for the visitor gate and kitchen idle e2e tests (default http://localhost:4173)
GATE_URL=
KITCHEN_URL=

# --- Tests ---
# 1 = regenerate fixtures/views/*.json from the view tests
WRITE_VIEW_FIXTURES=
# 1 = print agent runs in the agent tests
AGENT_LOG=
